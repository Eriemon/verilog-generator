      {"case_dir": "cli-verify-existing-rtl-timing", "source_name": "missing_output_register.v", "spec_name": "missing_output_register_spec.md", "copy_name": "missing_output_register.v", "automation_mode": "auto_apply", "decision_evidence": "approved timing patch", "expected_category": "output_register_completion", "error_label": "output register patch"}
