  "fpga_developer_routing": {
    "state_path": ".readable-verilog-generator-state/dependency-state.json",
    "selection_policy": "ask_on_first_fpga_workflow",
    "persist_selection": true,
    "fpga_agent_required_when_developer_present": false,
    "vendors": {
      "amd_xilinx": {
        "label": "AMD-Xilinx",
        "skills": [
          "vivado-developer",
          "vitis-developer"
        ]
      },
      "pangomicro": {
        "label": "PangoMicro",
        "skills": [
          "pds-developer"
        ]
      }
    }
  },
  "workflow": {
    "mode": "generate",
    "generation_mode": "regular",
    "target": "rtl",
    "readiness": "static",
    "max_attempts": 3,
    "comment_language": "zh",
    "model_provider": "command",
    "stop_on_human": true,
    "run_external": true,
    "stream": false,
    "model_timeout_s": 120,
    "rtl_style_profile": "erie_strict"
  },
  "policy": {
    "local_static_allowed": true,
    "allow_implicit_local_external_validation": false,
    "prefer_remote_for_external_validation": true,
    "block_when_remote_unconfigured": true
  },
  "validation": {
    "local_readiness": "static",
    "remote_readiness": "execute",
    "blocked_implement_readiness": "implement",
    "external_tools": [
      "xvlog",
      "xelab",
      "xsim",
      "vcs",
      "verdi",
      "iverilog",
      "vvp",
      "yosys"
    ],
    "simulators": {
      "selection_policy": "fallback",
      "priority": [
        "xsim",
        "vcs_verdi",
        "iverilog"
      ],
      "backends": {
        "xsim": {
          "tools": [
            "xvlog",
            "xelab",
            "xsim"
          ]
        },
        "vcs_verdi": {
          "tools": [
            "vcs",
            "verdi"
          ]
        },
        "iverilog": {
          "tools": [
            "iverilog",
            "vvp"
          ]
        }
      }
    },
    "markdown_non_ascii_allowlist": [
      "README.md",
      "README-CN.md",
      "references/rules/verilog-code-comment-naming-standard.md",
      "references/corpus/verilog-style-observations.md"
    ],
    "legacy_term_allowlist": [
      "assets/ideal_bad_style_metrics.json",
      "assets/verilog_style_rules.json",
      "scripts/python/facade/verilog_api.py",
      "references/checklists/verilog-readability-gate.md",
      "references/rules/verilog-code-comment-naming-standard.md",
      "scripts/python/facade/verilog_api.py",
      "scripts/python/workflow/cli.py",
      "scripts/python/quality/deliverable_gate.py",
      "scripts/python/quality/formatter_backend/layout_mixin.py",
      "scripts/python/quality/quality_gate.py",
      "scripts/python/quality/quality_gate_common.py",
      "scripts/python/quality/quality_gate_structure_rules.py",
      "scripts/python/quality/quality_gate_types.py",
      "scripts/python/remote/remote_validate_snippets.py",
      "scripts/python/toolchain/dependency_fpga_route.py",
      "scripts/python/validation/validation_source_audit.py",
      "scripts/python/validation/generated_deliverable_gate.py",
      "scripts/python/quality/verilog_quality_gate.py",
      "config/registry/commands/toolchain.json",
      "config/registry/registry.sqlite3",
      "scripts/python/validation/generated_deliverable_gate.py",
      "scripts/python/quality/verilog_quality_gate.py"
    ],
    "forbidden_residuals": [
      "__pycache__",
      "_smoke_runs",
      "workflow-state.json"
    ],
    "formatter_ast_quality_gate": {
      "enabled": true,
      "strict": true,
      "formatter_profile": "formatter-normalize",
      "comment_language": "zh",
      "comment_only_pipeline_required": true
    }
  },
  "remote": {
    "integration": {
      "remote_ssh_helper": "${home}/.codex/skills/erie-remote-ssh/scripts/python/runtime/remote_ssh.py",
      "remote_ssh_settings": "${home}/.codex/skills/erie-remote-ssh/assets/defaults.json",
      "selection_file": ".settings/remote-selection.local.json",
      "server_list": ".settings/server_list.local.json",
      "remote_runtime_config": ".settings/verilog.remote.json"
    },
    "python": "python3",
    "remote_root": ".readable-verilog-generator",
    "timeout_s": 600
  }
