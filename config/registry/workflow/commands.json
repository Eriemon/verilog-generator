    {
      "id": "workflow.validate", "category": "workflow", "entrypoint": "scripts.python.workflow.cli", "subcommand": "validate", "title": "验证工作流产物", "summary": "按 spec 验证产物目录，并根据 static、compile、execute 或 implement readiness 选择相应证据门禁。", "when_to_use": "已有 spec 与生成目录，需要只读判断当前 readiness 时。",
