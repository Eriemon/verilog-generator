      "invocation_templates": ["python -m scripts.python.workflow.cli run-workflow --spec <spec.json> --out-dir <run-dir> --model-provider <provider> --generation-mode <mode> [--stream] [--no-external]"], "examples": {"valid": ["python -m scripts.python.workflow.cli run-workflow --spec .\\assets\\examples\\rtl_erie_verilog_spec.json --out-dir .\\reports\\verilog\\regular --model-provider mock --generation-mode regular --no-external"], "invalid": ["deep_review 不能省略 review 产物或把静态验证说成外部仿真"]}, "prerequisites": ["spec 满足输入 schema", "依赖 preflight 已明确可用范围"], "outputs": {"format": "artifact-directory", "success_exit_codes": [0], "failure_exit_codes": [1, 2]}, "risk": {"level": "medium", "writes": true, "warning": "会在 out-dir 创建受管运行产物"}, "boundaries": ["生成必须先有 codegen plan", "不覆盖用户 RTL", "regular 与 deep_review 的语义路径保持明确"], "related_command_ids": ["workflow.prompt", "workflow.validate", "validation.generated-deliverable"]
