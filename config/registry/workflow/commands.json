      "parameters": [{"name": "--spec", "required": true, "description": "规范 JSON"}, {"name": "--path", "required": true, "description": "待验证产物路径"}, {"name": "--no-external", "required": false, "description": "仅静态 readiness 禁用外部工具"}, {"name": "--report-json", "required": false, "description": "验证 JSON 报告"}, {"name": "--readiness", "required": false, "description": "static、compile、execute 或 implement"}, {"name": "--external-target", "required": false, "description": "local 或显式远程目标"}],
