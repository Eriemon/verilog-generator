{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-catalog.schema.json",
  "title": "Document and knowledge metadata catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "documents"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["draft", "reviewed", "current"]},
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "responsibility", "summary", "title", "keywords", "source_anchor", "content_sha256", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^document\\."},
          "path": {"type": "string", "pattern": "^(SKILL\\.md|references/.+\\.md)$"},
          "responsibility": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "source_anchor": {"type": "string"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["draft", "reviewed", "current"]}
        }
      }
    }
  }
}
