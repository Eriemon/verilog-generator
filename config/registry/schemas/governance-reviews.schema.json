{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "governance-reviews.schema.json",
  "title": "Current document governance review decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "user_confirmation", "exact_reviews", "fuzzy_reviews", "interface_reviews"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["pending_agent_review", "agent_reviewed", "current"]},
    "user_confirmation": {"enum": ["not_required", "confirmed"]},
    "exact_reviews": {"type": "array"},
    "fuzzy_reviews": {"type": "array"},
    "interface_reviews": {"type": "array"}
  }
}
