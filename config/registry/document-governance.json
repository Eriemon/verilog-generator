{
  "catalog": "documents/catalog.json",
  "enabled": true,
  "knowledge_index": "knowledge/index.json",
  "migration": "migrations/initial-document-registration.json",
  "scan_scope": [
    "SKILL.md",
    "references/**/*.md"
